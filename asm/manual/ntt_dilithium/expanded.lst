  24              	    #define in       x10  // == a0, first function arg
  25              	    #define count    x3
  26              	    #define modulus  x4
  27              	    #define root_ptr x5
  28              	    #define xtmp     x6
  29              	
  30              	    #define data0  v0
  31              	    #define data1  v1
  32              	    #define data2  v2
  33              	    #define data3  v3
  34              	    #define data4  v4
  35              	    #define data5  v5
  36              	    #define data6  v6
  37              	    #define data7  v7
  38              	    #define data8  v8
  39              	    #define data9  v9
  40              	    #define data10 v10
  41              	    #define data11 v11
  42              	    #define data12 v12
  43              	    #define data13 v13
  44              	    #define data14 v14
  45              	    #define data15 v15
  46              	
  47              	    // load first 5 roots only on demand due to limited number of registers
  48              	    #define barretc_1  x7     // root1 = \psi^bitinverse(1), root2 = \psi^bitinverse(2) ...
  49              	    #define barretc_2  x8     // barretc_1 = floor((root1 << k)\modulus) ...
  50              	    #define barretc_3  x9
  51              	    #define barretc_4  x1
  52              	    #define barretc_5  x11
  53              	    #define root6      x12
  54              	    #define barretc_6  x13
  55              	    #define root7      x14
  56              	    #define barretc_7  x15
  57              	    #define root8      x16
  58              	    #define barretc_8  x17
  59              	    #define root9      x18
  60              	    #define barretc_9  x19
  61              	    #define root10     x20
  62              	    #define barretc_10 x21
  63              	    #define root11     x22
  64              	    #define barretc_11 x23
  65              	    #define root12     x24
  66              	    #define barretc_12 x25
  67              	    #define root13     x26
  68              	    #define barretc_13 x27
  69              	    #define root14     x28
  70              	    #define barretc_14 x29
  71              	    #define root15     x30
  72              	    #define barretc_15 x31
  73              	
  74              	    #define vtmp0    v16  // used by barret_mul
  75              	    #define vtmp1    v17  // used by ct_butterfly
  76              	    #define vtmp2    v18  // free to use
  77              	    #define vmodulus v19  // vectorized modulus
  78              	
  79              	.macro barret_mul dst, a, b, barret_const
  80              	    vmul.vx \dst, \a, \b                            // z = a*b = coefficient (vect) * root (scalar)
  81              	    vmulhu.vx vtmp0, \a, \barret_const              // t = (a * barret_const) >> k
  82              	    vnmsac.vx \dst, modulus, vtmp0                  // z = z - n * t
  83              	.endm
  84              	
  85              	.macro ct_butterfly a, b, root, barret_const
  86              	    barret_mul vtmp1, \b, \root, \barret_const         // vtmp1 = root * b mod modulus
  87              	    vsub.vv \b, \a, vtmp1                           // b = b - vtmp1
  88              	    vadd.vv \a, \a, vtmp1                           // a = a + vtmp1
  89              	.endm
  90              	
  91              	.macro barret_mul_v vdst, va, vb, vbarret_const
  92              	    vmul.vv \vdst, \va, \vb                         // z = a*b = coefficient (vect) * root (scalar)
  93              	    vmulhu.vv vtmp0, \va, \vbarret_const            // t = (a * barret_const) >> k
  94              	    vnmsac.vx \vdst, modulus, vtmp0                // z = z - n * t
  95              	.endm
  96              	
  97              	.macro ct_butterfly_v va, vb, vroot, vbarret_const
  98              	    barret_mul_v vtmp1, \vb, \vroot, \vbarret_const    // vtmp1 = vroot * vb mod modulus
  99              	    vsub.vv \vb, \va, vtmp1                         // b = b - vtmp1
 100              	    vadd.vv \va, \va, vtmp1                         // a = a + vtmp1
 101              	.endm
 102              	
 103              	.macro transpose4 data, ptr
 104              	    vsseg4e32.v \data, (\ptr)
 105              	    vl4re32.v \data, (\ptr)  // loads data into data0, data1, data2, data3
 106              	    // alternative:
 107              	    // vle32.v data0, ptr
 108              	    // vle32.v data1, ptr+1 etc.
 109              	.endm
 110              	
 111              	.macro load_roots_1234  root_ptr, barretc_1, barretc_2, barretc_3, barretc_4, barretc_5,        \
 112              	                        root6, barretc_6, root7, barretc_7, root8, barretc_8, root9, barretc_9, \
 113              	                        root10, barretc_10, root11, barretc_11, root12, barretc_12, root13,     \
 114              	                        barretc_13, root14, barretc_14, root15, barretc_15
 115              	    lw \barretc_1,  (0*8+4)(\root_ptr)
 116              	    lw \barretc_2,  (1*8+4)(\root_ptr)
 117              	    lw \barretc_3,  (2*8+4)(\root_ptr)
 118              	    lw \barretc_4,  (3*8+4)(\root_ptr)
 119              	    lw \barretc_5,  (4*8+4)(\root_ptr)
 120              	    lw \root6,      (5*8)(\root_ptr)
 121              	    lw \barretc_6,  (5*8+4)(\root_ptr)
 122              	    lw \root7,      (6*8)(\root_ptr)
 123              	    lw \barretc_7,  (6*8+4)(\root_ptr)
 124              	    lw \root8,      (7*8)(\root_ptr)
 125              	    lw \barretc_8,  (7*8+4)(\root_ptr)
 126              	    lw \root9,      (8*8)(\root_ptr)
 127              	    lw \barretc_9,  (8*8+4)(\root_ptr)
 128              	    lw \root10,     (9*8)(\root_ptr)
 129              	    lw \barretc_10, (9*8+4)(\root_ptr)
 130              	    lw \root11,     (10*8)(\root_ptr)
 131              	    lw \barretc_11, (10*8+4)(\root_ptr)
 132              	    lw \root12,     (11*8)(\root_ptr)
 133              	    lw \barretc_12, (11*8+4)(\root_ptr)
 134              	    lw \root13,     (12*8)(\root_ptr)
 135              	    lw \barretc_13, (12*8+4)(\root_ptr)
 136              	    lw \root14,     (13*8)(\root_ptr)
 137              	    lw \barretc_14, (13*8+4)(\root_ptr)
 138              	    lw \root15,     (14*8)(\root_ptr)
 139              	    lw \barretc_15, (14*8+4)(\root_ptr)
 140              	.endm
 141              	
 142              	
 143              	.macro load_roots_5678  xroot1, xbarretc_1, xroot2, xbarretc_2, xroot3, xbarretc_3, \
 144              	                        vroot1, vbarretc_1, vroot2, vbarretc_2,  vroot3, vbarretc_3,\
 145              	                        root_ptr
 146              	    lw \xroot1,     (0*8)(\root_ptr)
 147              	    lw \xbarretc_1, (0*8+4)(\root_ptr)
 148              	    lw \xroot2,     (1*8)(\root_ptr)
 149              	    lw \xbarretc_2, (1*8+4)(\root_ptr)
 150              	    lw \xroot3,     (2*8)(\root_ptr)
 151              	    lw \xbarretc_3,  (2*8+4)(\root_ptr)
 152              	    addi \root_ptr, \root_ptr, 3*8  // increment root_ptr manually here, bc vle32 does not allow of
 153              	    vle32.v \vroot1, (\root_ptr)
 154              	    addi \root_ptr, \root_ptr, 16
 155              	    vle32.v \vbarretc_1, (\root_ptr)
 156              	    addi \root_ptr, \root_ptr, 16
 157              	    vle32.v \vroot2, (\root_ptr)
 158              	    addi \root_ptr, \root_ptr, 16
 159              	    vle32.v \vbarretc_2, (\root_ptr)
 160              	    addi \root_ptr, \root_ptr, 16
 161              	    vle32.v \vroot3, (\root_ptr)
 162              	    addi \root_ptr, \root_ptr, 16
 163              	    vle32.v \vbarretc_3, (\root_ptr)
 164              	    addi \root_ptr, \root_ptr, 16
 165              	.endm
 166              	
 167              	.macro load16 in, stride
 168              	    .irp r, data0,data1,data2,data3,data4,data5,data6,data7,\
 169              	            data8,data9,data10,data11,data12,data13,data14
 170              	        vle32.v \r, (\in)
 171              	        addi \in, \in, \stride
 172              	    .endr
 173              	    vle32.v data15, (\in)
 174              	.endm
 175              	
 176              	.macro store16 in, stride
 177              	    .irp r, data0,data1,data2,data3,data4,data5,data6,data7,\
 178              	            data8,data9,data10,data11,data12,data13,data14
 179              	        vse32.v \r, (\in)
 180              	        addi \in, \in, \stride
 181              	    .endr
 182              	    vse32.v data15, (\in)
 183              	.endm
 184              	
 185              	.macro push_stack
 186              	    addi sp, sp, -8*15
 187              	    sd s0,  0*8(sp)
 188              	    sd s1,  1*8(sp)
 189              	    sd s2,  2*8(sp)
 190              	    sd s3,  3*8(sp)
 191              	    sd s4,  4*8(sp)
 192              	    sd s5,  5*8(sp)
 193              	    sd s6,  6*8(sp)
 194              	    sd s7,  7*8(sp)
 195              	    sd s8,  8*8(sp)
 196              	    sd s9,  9*8(sp)
 197              	    sd s10, 10*8(sp)
 198              	    sd s11, 11*8(sp)
 199              	    sd gp,  12*8(sp)
 200              	    sd tp,  13*8(sp)
 201              	    sd ra,  14*8(sp)
 202              	.endm
 203              	
 204              	.macro pop_stack
 205              	    ld s0,  0*8(sp)
 206              	    ld s1,  1*8(sp)
 207              	    ld s2,  2*8(sp)
 208              	    ld s3,  3*8(sp)
 209              	    ld s4,  4*8(sp)
 210              	    ld s5,  5*8(sp)
 211              	    ld s6,  6*8(sp)
 212              	    ld s7,  7*8(sp)
 213              	    ld s8,  8*8(sp)
 214              	    ld s9,  9*8(sp)
 215              	    ld s10, 10*8(sp)
 216              	    ld s11, 11*8(sp)
 217              	    ld gp,  12*8(sp)
 218              	    ld tp,  13*8(sp)
 219              	    ld ra,  14*8(sp)
 220              	    addi sp, sp, 8*15
 221              	.endm
